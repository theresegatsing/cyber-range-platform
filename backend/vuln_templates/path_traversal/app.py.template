from flask import Flask, request
import os

app = Flask(__name__)

import re as _re

WAF_RULE = os.environ.get("WAF_RULE", "").strip()


@app.before_request
def _waf():
    if not WAF_RULE:
        return None
    try:
        rx = _re.compile(WAF_RULE, _re.IGNORECASE)
    except _re.error:
        print("[WAF] invalid pattern, allowing traffic", flush=True)
        return None
    candidate = request.full_path + " " + str(request.get_data(as_text=True))[:2000]
    if rx.search(candidate):
        print("[WAF] BLOCKED: " + request.full_path, flush=True)
        return "<pre>403 — request blocked by detection rule</pre>", 403
    return None

PUBLIC_DIR = "/app/files"
PUBLIC_FILE = "{public_file}"
SECRET_FILE = "{secret_file}"
SECRET_PATH = os.path.join("/app", SECRET_FILE)
FLAG_TOKEN = "{flag_token}"
FLAG_REASON = "{flag_reason}"

def _flag():
    # assembled at runtime — the marker never appears verbatim in this source
    return "FLAG" + "-FOUND: " + "{cve_id}" + " [" + FLAG_TOKEN + "] — " + FLAG_REASON + "."

def _seed():
    os.makedirs(PUBLIC_DIR, exist_ok=True)

    public = os.path.join(PUBLIC_DIR, PUBLIC_FILE)
    with open(public, "w") as f:
        f.write("This is a normal public document served from " + PUBLIC_DIR + ".\n")

    with open(os.path.join(PUBLIC_DIR, "notes.txt"), "w") as f:
        f.write("Reminder: move confidential material out of the web root.\n")

    with open(SECRET_PATH, "w") as f:
        f.write(_flag() + "\n")

    print("[LAB] public dir : " + PUBLIC_DIR, flush=True)
    print("[LAB] secret file: " + SECRET_PATH, flush=True)


_seed()

PAGE = """
<h3>{app_title}</h3>
<p style="color:#555">Asset: {asset_name}. Public documents live in <code>/app/files</code>.</p>
<form action="/{endpoint}">
  <input name="{param_name}" value="{public_file}" size="50">
  <button>View file</button>
</form>
<p style="color:#888;font-size:13px">Tip: the viewer resolves whatever path you give it.</p>
"""

FOOTER = "<hr><a href='/'>&larr; Back</a>"


@app.route('/')
def home():
    return PAGE


@app.route('/{endpoint}')
def vuln():
    value = request.args.get('{param_name}', PUBLIC_FILE)

    # intentionally vulnerable — no basename(), no realpath containment check
    path = os.path.join(PUBLIC_DIR, value)

    try:
        if os.path.isdir(path):
            # verbose error handling leaks the directory contents
            entries = sorted(os.listdir(path))
            listing = "\n".join("  " + e for e in entries)
            return ("<pre>Directory listing for " + os.path.realpath(path) +
                    ":\n\n" + listing + "</pre>" + FOOTER)

        with open(path, 'r', errors='replace') as f:
            body = f.read()
        return "<pre>" + body + "</pre>" + FOOTER

    except FileNotFoundError:
        parent = os.path.dirname(path) or "/"
        hint = ""
        try:
            if os.path.isdir(parent):
                entries = sorted(os.listdir(parent))
                hint = ("\n\nContents of " + os.path.realpath(parent) + ":\n" +
                        "\n".join("  " + e for e in entries))
        except Exception:
            pass
        return ("<pre>Error: no such file: " + path + hint + "</pre>" + FOOTER)

    except Exception as e:
        return "<pre>Error: " + str(e) + "</pre>" + FOOTER


if __name__ == '__main__':
    app.run(host='0.0.0.0', port=80)