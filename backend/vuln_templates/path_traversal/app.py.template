from flask import Flask, request
import os

app = Flask(__name__)
SECRET_CONTENT = "FLAG-FOUND: {app_title} — you escaped the sandbox and read a protected file."

@app.route('/')
def home():
    os.makedirs('/app/files', exist_ok=True)
    with open('/app/files/readme.txt', 'w') as f:
        f.write("This is a normal public file.")
    with open('/app/secret.txt', 'w') as f:
        f.write(SECRET_CONTENT)
    return '<h3>{app_title}</h3><form action="/vuln"><input name="file" value="readme.txt"><button>View file</button></form>'

@app.route('/vuln')
def vuln():
    filename = request.args.get('file', 'readme.txt')
    try:
        # intentionally vulnerable — no path sanitization
        path = os.path.join('/app/files', filename)
        with open(path, 'r') as f:
            return f"<pre>{{f.read()}}</pre>"
    except Exception as e:
        return f"Error: {{e}}"

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=80)