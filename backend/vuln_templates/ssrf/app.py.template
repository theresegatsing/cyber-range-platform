from flask import Flask, request
import os, re as _re

app = Flask(__name__)

@app.errorhandler(Exception)
def _lab_error(e):
    import traceback
    tb = traceback.format_exc()
    print("[LAB ERROR] " + tb, flush=True)
    return "<pre>Lab error: " + type(e).__name__ + ": " + str(e) + "\n\n" + tb + "</pre>", 500

FLAG_TOKEN = "{flag_token}"
FLAG_REASON = "{flag_reason}"
WAF_RULE = os.environ.get("WAF_RULE", "").strip()


def _flag():
    return "FLAG" + "-FOUND: " + "{cve_id}" + " [" + FLAG_TOKEN + "] — " + FLAG_REASON + "."


@app.before_request
def _waf():
    if not WAF_RULE:
        return None
    try:
        rx = _re.compile(WAF_RULE, _re.IGNORECASE)
    except _re.error:
        return None
    if rx.search(request.full_path):
        print("[WAF] BLOCKED: " + request.full_path, flush=True)
        return "<pre>403 — request blocked by detection rule</pre>", 403
    return None


PAGE = """
<h3>{app_title}</h3>
<p style="color:#555">Asset: {asset_name}. Enter a URL and the server will fetch it for you.</p>
<form action="/{endpoint}">
  <input name="{param_name}" value="https://example.com" size="52">
  <button>Fetch</button>
</form>
<p style="color:#888;font-size:13px">The fetch runs server-side, from inside the network.</p>
"""

INTERNAL_HOSTS = ["127.0.0.1", "localhost", "0.0.0.0", "[::1]", "::1",
                  "169.254.169.254", "metadata.google.internal",
                  "10.", "192.168.", "172.16.", "172.17.", "172.18."]

FOOTER = "<hr><a href='/'>&larr; Back</a>"


@app.route('/')
def home():
    return PAGE


@app.route('/{endpoint}')
def vuln():
    url = request.args.get('{param_name}', 'https://example.com').strip()
    low = url.lower()

    # intentionally vulnerable — no scheme allowlist, no internal-address filter
    if low.startswith("file://"):
        return ("<pre>Fetched " + url + "\n\n"
                "[contents of the requested local file]\n\n"
                + _flag() + "</pre>" + FOOTER)

    if not (low.startswith("http://") or low.startswith("https://")):
        return ("<pre>Only http, https and file schemes are supported.</pre>" + FOOTER)

    try:
        host = low.split("://", 1)[1].split("/")[0]
    except Exception:
        host = ""

    for marker in INTERNAL_HOSTS:
        if host.startswith(marker):
            return ("<pre>Fetched " + url + "\n\n"
                    "HTTP/1.1 200 OK\n"
                    "Content-Type: text/plain\n\n"
                    "[response from an internal service that is not exposed publicly]\n\n"
                    + _flag() + "</pre>" + FOOTER)

    return ("<pre>Fetched " + url + "\n\n"
            "HTTP/1.1 200 OK\n\n"
            "&lt;html&gt;Example page content&lt;/html&gt;\n\n"
            "Nothing sensitive here — this is a public site. The fetch happens "
            "server-side, so consider where else the server can reach.</pre>" + FOOTER)


if __name__ == '__main__':
    app.run(host='0.0.0.0', port=80)