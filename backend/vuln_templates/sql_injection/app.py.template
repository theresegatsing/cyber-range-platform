from flask import Flask, request
import sqlite3
import os
import re as _re

app = Flask(__name__)

@app.errorhandler(Exception)
def _lab_error(e):
    import traceback
    tb = traceback.format_exc()
    print("[LAB ERROR] " + tb, flush=True)
    return "<pre>Lab error: " + type(e).__name__ + ": " + str(e) + "\n\n" + tb + "</pre>", 500


WAF_RULE = os.environ.get("WAF_RULE", "").strip()

DB = "/app/lab.db"
TABLE = "{table_name}"
COLUMNS = {column_names}
ROWS = ["{sample_row_1}", "{sample_row_2}"]
FLAG_TOKEN = "{flag_token}"
FLAG_REASON = "{flag_reason}"


def _flag():
    return "FLAG" + "-FOUND: " + "{cve_id}" + " [" + FLAG_TOKEN + "] — " + FLAG_REASON + "."


@app.before_request
def _waf():
    if not WAF_RULE:
        return None
    try:
        rx = _re.compile(WAF_RULE, _re.IGNORECASE)
    except _re.error:
        print("[WAF] invalid pattern, allowing traffic", flush=True)
        return None
    candidate = request.full_path + " " + str(request.get_data(as_text=True))[:2000]
    if rx.search(candidate):
        print("[WAF] BLOCKED: " + request.full_path, flush=True)
        return "<pre>403 — request blocked by detection rule</pre>", 403
    return None


def _seed():
    if os.path.exists(DB):
        os.remove(DB)
    conn = sqlite3.connect(DB)
    conn.execute("CREATE TABLE " + TABLE + " (" + ", ".join(c + " TEXT" for c in COLUMNS) + ")")
    marks = ", ".join("?" for _ in COLUMNS)
    for row in ROWS:
        vals = [v.strip() for v in row.split(",")]
        vals = (vals + [""] * len(COLUMNS))[:len(COLUMNS)]
        conn.execute("INSERT INTO " + TABLE + " VALUES (" + marks + ")", vals)
    conn.commit()
    conn.close()
    print("[LAB] table: " + TABLE + " (" + ", ".join(COLUMNS) + ")", flush=True)
    print("[LAB] rows seeded: " + str(len(ROWS)), flush=True)


_seed()

PAGE = """
<h3>{app_title}</h3>
<p style="color:#555">Asset: {asset_name}. Look up a record from <code>{table_name}</code>.</p>
<form action="/{endpoint}">
  <input name="{param_name}" value="1" size="44">
  <button>Look up</button>
</form>
<p style="color:#888;font-size:13px">The query is echoed back with the results.</p>
"""


@app.route('/')
def home():
    return PAGE


@app.route('/{endpoint}')
def vuln():
    value = request.args.get('{param_name}', '1')
    key = COLUMNS[0]
    # intentionally vulnerable — raw string concatenation, no parameter binding
    query = "SELECT * FROM " + TABLE + " WHERE " + key + " = '" + value + "'"
    try:
        conn = sqlite3.connect(DB)
        rows = conn.execute(query).fetchall()
        conn.close()
    except Exception as e:
        # verbose SQL errors leak the query structure
        return ("<pre>SQL error: " + str(e) + "\nQuery: " + query +
                "</pre><hr><a href='/'>&larr; Back</a>")

    out = "<pre>Query: " + query + "\n\n"
    for r in rows:
        out += str(r) + "\n"
    out += "\n" + str(len(rows)) + " row(s) returned\n"
    if len(rows) > len(ROWS) - 1 and len(rows) > 1:
        out += "\n" + _flag() + "\n"
    return out + "</pre><hr><a href='/'>&larr; Back</a>"


if __name__ == '__main__':
    app.run(host='0.0.0.0', port=80)