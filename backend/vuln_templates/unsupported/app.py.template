from flask import Flask
import os

app = Flask(__name__)

import re as _re

WAF_RULE = os.environ.get("WAF_RULE", "").strip()


@app.before_request
def _waf():
    if not WAF_RULE:
        return None
    try:
        rx = _re.compile(WAF_RULE, _re.IGNORECASE)
    except _re.error:
        print("[WAF] invalid pattern, allowing traffic", flush=True)
        return None
    candidate = request.full_path + " " + str(request.get_data(as_text=True))[:2000]
    if rx.search(candidate):
        print("[WAF] BLOCKED: " + request.full_path, flush=True)
        return "<pre>403 — request blocked by detection rule</pre>", 403
    return None

PAGE = """
<div style="font-family:system-ui;max-width:680px;margin:40px auto;line-height:1.6">
  <h3>{cve_id}</h3>
  <p style="color:#b45309;background:#fffbeb;padding:12px;border-left:4px solid #f59e0b">
    No exploitable lab exists for this vulnerability class yet. This mission is
    read-only: study the description, then write your detection and remediation
    recommendations in the report.
  </p>
  <h4>Description</h4>
  <p style="color:#334155">{description}</p>
</div>
"""


@app.route('/')
@app.route('/<path:_ignored>')
def home(_ignored=None):
    return PAGE


if __name__ == '__main__':
    app.run(host='0.0.0.0', port=80)