from flask import Flask, request
import subprocess
import os

app = Flask(__name__)

import re as _re

WAF_RULE = os.environ.get("WAF_RULE", "").strip()


@app.before_request
def _waf():
    if not WAF_RULE:
        return None
    try:
        rx = _re.compile(WAF_RULE, _re.IGNORECASE)
    except _re.error:
        print("[WAF] invalid pattern, allowing traffic", flush=True)
        return None
    candidate = request.full_path + " " + str(request.get_data(as_text=True))[:2000]
    if rx.search(candidate):
        print("[WAF] BLOCKED: " + request.full_path, flush=True)
        return "<pre>403 — request blocked by detection rule</pre>", 403
    return None

BASE_COMMAND = "{base_command}"
FLAG = "{flag_message}"


def _seed():
    if not os.path.exists("/app/secret.txt"):
        with open("/app/secret.txt", "w") as f:
            f.write(FLAG + "\n")


_seed()

PAGE = """
<h3>{app_title}</h3>
<p style="color:#555">Asset: {asset_name}. Runs <code>{base_command} &lt;input&gt;</code> on the host.</p>
<form action="/{endpoint}">
  <input name="{param_name}" value="127.0.0.1" size="44">
  <button>Run</button>
</form>
"""


@app.route('/')
def home():
    return PAGE


@app.route('/{endpoint}')
def vuln():
    value = request.args.get('{param_name}', '127.0.0.1')
    # intentionally vulnerable — shell=True with unsanitized user input appended
    cmd = BASE_COMMAND + " " + value
    try:
        out = subprocess.run(cmd, shell=True, capture_output=True,
                             text=True, timeout=8)
        body = (out.stdout or "") + (out.stderr or "")
    except subprocess.TimeoutExpired:
        body = "Command timed out."
    except Exception as e:
        body = "Error: " + str(e)
    return f"<pre>$ {{cmd}}\n\n{{body}}</pre><hr><a href='/'>&larr; Back</a>"


if __name__ == '__main__':
    app.run(host='0.0.0.0', port=80)