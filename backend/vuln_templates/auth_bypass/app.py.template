from flask import Flask, request
import os, re as _re

app = Flask(__name__)
FLAG_TOKEN = "{flag_token}"
FLAG_REASON = "{flag_reason}"
WAF_RULE = os.environ.get("WAF_RULE", "").strip()


def _flag():
    return "FLAG" + "-FOUND: " + "{cve_id}" + " [" + FLAG_TOKEN + "] — " + FLAG_REASON + "."


@app.before_request
def _waf():
    if not WAF_RULE:
        return None
    try:
        rx = _re.compile(WAF_RULE, _re.IGNORECASE)
    except _re.error:
        return None
    if rx.search(request.full_path):
        print("[WAF] BLOCKED: " + request.full_path, flush=True)
        return "<pre>403 — request blocked by detection rule</pre>", 403
    return None

PAGE = """
<h3>{app_title}</h3>
<p style="color:#555">Asset: {asset_name}. Authenticated area.</p>
<form action="/{endpoint}">
  <input name="{param_name}" value="{public_file}" size="40">
  <button>Enter console</button>
</form>
"""


@app.route('/')
def home():
    return PAGE


@app.route('/{endpoint}')
def vuln():
    # intentionally vulnerable — absent parameter treated as authorised,
    # and the privileged value is a guessable string rather than a signed token
    if '{param_name}' not in request.args:
        return ("<pre>No token supplied — defaulting to trusted internal caller.\\n\\n" +
                _flag() + "</pre><hr><a href='/'>&larr; Back</a>")

    token = request.args.get('{param_name}', '').strip().lower()
    if token in ("{secret_file}", "administrator", "root", "true", "1"):
        return ("<pre>Token accepted: " + token + "\\nAccess level: administrative\\n\\n" +
                _flag() + "</pre><hr><a href='/'>&larr; Back</a>")

    return ("<pre>Token: " + token + "\\nAccess level: guest. "
            "Administrative functions are hidden.</pre><hr><a href='/'>&larr; Back</a>")


if __name__ == '__main__':
    app.run(host='0.0.0.0', port=80)